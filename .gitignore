# --- Général ---
.DS_Store
*.log
.env
.env.*
!.env.example

# --- iOS / Xcode / SwiftPM ---
ios/**/.build/
ios/**/DerivedData/
ios/**/*.xcuserstate
ios/**/xcuserdata/
ios/**/.swiftpm/
*.ipa
*.dSYM.zip
# Le projet Xcode est GÉNÉRÉ depuis ios/project.yml (XcodeGen) : ne pas le committer,
# c'est la source de tous les conflits Git sur un projet iOS.
ios/*.xcodeproj/
ios/*.xcworkspace/
ios/Package.resolved
ios/**/Package.resolved
ios/build/
ios/**/*.xcresult
# Configuration Firebase de l'app iOS : contient les identifiants du projet.
ios/App/Resources/GoogleService-Info.plist

# --- Android / Gradle ---
.gradle/
**/build/
local.properties
*.apk
*.aab
*.keystore
!debug.keystore
android/**/.cxx/

# --- KMM / Kotlin ---
shared-domain/build/
**/*.klib

# --- IDE ---
.idea/
*.iml
.vscode/

# --- Fastlane ---
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/**/*.png
**/fastlane/test_output/

# Secrets Firebase — clé de service (NE JAMAIS committer)
**/*firebase-adminsdk*.json
docs/google-services*.json
