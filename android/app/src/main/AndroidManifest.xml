<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Accès réseau (pour brancher le backend plus tard). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".DualMusicApp"
        android:label="Dual Music"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.DualMusic">

        <!--
          Désactive l'auto-initialisation de Sentry (son SentryInitProvider s'exécute AVANT
          notre Application et planterait sans DSN : « DSN is required »). L'init se fait
          exclusivement dans DualMusicApp (no-op sûr tant que le DSN est vide).
        -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DualMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
